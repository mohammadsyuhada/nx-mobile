diff --git a/src/drivers/libretro/libretro.c b/src/drivers/libretro/libretro.c
index 5ecaa3f..07f9e19 100644
--- a/src/drivers/libretro/libretro.c
+++ b/src/drivers/libretro/libretro.c
@@ -1834,7 +1834,14 @@ void retro_set_environment(retro_environment_t cb)
    vfs_iface_info.required_interface_version = FILESTREAM_REQUIRED_VFS_VERSION;
    vfs_iface_info.iface                      = NULL;
    if (environ_cb(RETRO_ENVIRONMENT_GET_VFS_INTERFACE, &vfs_iface_info))
+   {
       filestream_vfs_init(&vfs_iface_info);
+      /* path_is_valid (the content check before filestream_open) goes
+       * through file_path_io's stat callback; without this it always stats
+       * the real filesystem, so frontend-virtual content paths fail. Only
+       * takes effect when the frontend offers VFS v3 or newer. */
+      path_vfs_init(&vfs_iface_info);
+   }
 
    environ_cb(RETRO_ENVIRONMENT_SET_CONTENT_INFO_OVERRIDE,
          (void*)content_overrides);
