+/* nx-mobile: state that init_memory and load_gamepak leave alone, reset at
+ * retro_init so a second session on the same loaded library starts clean. */
+void memory_reset_session(void)
+{
+  rtc_status = 0x40;
+  rtc_write_mode = 0;
+  rtc_command = 0;
+  rtc_data_bits = 0;
+  rtc_bit_count = 0;
+  rtc_data = 0;
+  rtc_base_time = 0;
+  rtc_enabled = false;
+  rumble_enabled = false;
+  gamepak_header_nonstandard = false;
+  is_known_game = false;
+}
