 static bool post_process_cc  = false;
 static bool post_process_mix = false;
 
+#if defined(HAVE_DYNAREC) && defined(MMAP_JIT_CACHE)
+/* nx-mobile: the recompiler cache must sit within +/-128 MB of the core's
+ * code, and a busy address space may have no such gap. The frontend keeps
+ * this .so loaded between games, so the block is mapped once, on the first
+ * retro_init, and reused by every later session. retro_deinit leaves it
+ * mapped; it is released only if the library itself is unloaded. */
+static u8 *nx_jit_block = NULL;
+
+__attribute__((destructor)) static void nx_unmap_jit_block(void)
+{
+   if (nx_jit_block)
+      unmap_jit_block(nx_jit_block, ROM_TRANSLATION_CACHE_SIZE + RAM_TRANSLATION_CACHE_SIZE);
+   nx_jit_block = NULL;
+}
+#endif
+
+/* nx-mobile: a second retro_init on the same loaded .so must start where a
+ * freshly loaded one does. Resets the state that nothing else in the init,
+ * load or reset path sets again (it was only reset by the frontend unloading
+ * the library between games). */
+static void nx_reset_session_state(void)
+{
+   cheat_clear();
+   input_reset_session();
+   memory_reset_session();
+   serial_set_irq_cycles(0);
+   serialproto_reset();
+
+   memset(palette_ram_converted, 0, sizeof(palette_ram_converted));
+   memset(affine_reference_x, 0, sizeof(affine_reference_x));
+   memset(affine_reference_y, 0, sizeof(affine_reference_y));
+
+   skip_next_frame   = 0;
+   sprite_limit      = 1;
+   rtc_mode          = FEAT_AUTODETECT;
+   rumble_mode       = FEAT_AUTODETECT;
+   serial_setting    = SERIAL_MODE_AUTO;
+   rumble_cb         = NULL;
+   main_path[0]      = '\0';
+}
+
 static void error_msg(const char* text)
 {
    if (log_cb)
@@ -575,6 +616,7 @@ void retro_get_system_av_info(struct retro_system_av_info* info)
 void retro_init(void)
 {
    u32 audio_sample_buffer_size;
+   nx_reset_session_state();
    audio_samples_per_frame   = (float)(GBA_SOUND_FREQUENCY) / (float)(GBA_FPS);
    audio_samples_accumulator = 0.0f;
    audio_sample_buffer_size  = ((u32)audio_samples_per_frame + 1) * 2;
@@ -593,8 +635,12 @@ void retro_init(void)
 
 #if defined(HAVE_DYNAREC)
   #if defined(MMAP_JIT_CACHE)
-   rom_translation_cache = map_jit_block(ROM_TRANSLATION_CACHE_SIZE + RAM_TRANSLATION_CACHE_SIZE);
-   ram_translation_cache = &rom_translation_cache[ROM_TRANSLATION_CACHE_SIZE];
+   /* nx-mobile: map once and keep it (see nx_jit_block). A failed mapping
+    * leaves both caches NULL, and retro_load_game refuses the game. */
+   if (!nx_jit_block)
+      nx_jit_block = (u8*)map_jit_block(ROM_TRANSLATION_CACHE_SIZE + RAM_TRANSLATION_CACHE_SIZE);
+   rom_translation_cache = nx_jit_block;
+   ram_translation_cache = nx_jit_block ? &nx_jit_block[ROM_TRANSLATION_CACHE_SIZE] : NULL;
   #elif defined(_3DS)
    if (__ctr_svchax && !translation_caches_inited)
    {
@@ -695,7 +741,9 @@ void retro_deinit(void)
    memory_term();
 
 #if defined(MMAP_JIT_CACHE) && defined(HAVE_DYNAREC)
-   unmap_jit_block(rom_translation_cache, ROM_TRANSLATION_CACHE_SIZE + RAM_TRANSLATION_CACHE_SIZE);
+   /* nx-mobile: the block stays mapped for the next session (nx_jit_block). */
+   rom_translation_cache = NULL;
+   ram_translation_cache = NULL;
 #endif
 #if defined(_3DS) && defined(HAVE_DYNAREC)
 
@@ -1149,6 +1197,17 @@ bool retro_load_game(const struct retro_game_info* info)
    if (!gba_screen_pixels)
       return false;
 
+#if defined(HAVE_DYNAREC) && defined(MMAP_JIT_CACHE)
+   /* nx-mobile: the emitter writes into this cache even with the dynarec
