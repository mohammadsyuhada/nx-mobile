+#ifdef HAVE_LIBRETRO_VFS
+// nx-mobile 2026-10-14: a file only the frontend's VFS serves (the game as /rom/<name>, read from the descriptor the
+// app holds: it has no storage permission, so there is no path to stat) is missed by a plain stat. Ask the VFS by
+// opening it: its size, or -1 when the VFS has no such file either.
+static int64_t VfsOnlySize(const std::string& filename) {
+    RFILE* f = filestream_open(filename.c_str(), RETRO_VFS_FILE_ACCESS_READ, RETRO_VFS_FILE_ACCESS_HINT_NONE);
+    if (f == nullptr) {
+        return -1;
+    }
+    const int64_t size = filestream_get_size(f);
+    filestream_close(f);
+    return size;
+}
+#endif
+
 bool Exists(const std::string& filename) {
