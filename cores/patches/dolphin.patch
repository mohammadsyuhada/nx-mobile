+// nx-mobile 2026-10-13: the async shader compiler's worker contexts. libretro has no shared-context call; the nx-mobile
+// runner offers one (NX_ENVIRONMENT_GET_SHARED_GL). Any other frontend: null, and Dolphin compiles on the GPU thread.
+namespace
+{
+class GLContextLRShared final : public GLContext
+{
+public:
+  GLContextLRShared(const nx_shared_gl_interface& gl, void* handle, Mode mode) : m_gl(gl), m_handle(handle)
+  {
+    m_opengl_mode = mode;
+    m_is_shared = true;
+  }
+  ~GLContextLRShared() override { m_gl.destroy(m_handle); }
+  bool IsHeadless() const override { return true; }
+  bool MakeCurrent() override { return m_gl.make_current(m_handle); }
+  bool ClearCurrent() override
+  {
+    m_gl.release(m_handle);
+    return true;
+  }
+  void* GetFuncAddress(const std::string& name) override
+  {
+    return (void*)Libretro::Video::hw_render.get_proc_address(name.c_str());
+  }
+
+private:
+  nx_shared_gl_interface m_gl;
+  void* m_handle;
+};
+}  // namespace
+
+std::unique_ptr<GLContext> GLContextLR::CreateSharedContext()
+{
+  nx_shared_gl_interface gl{};
+  if (!Libretro::environ_cb(NX_ENVIRONMENT_GET_SHARED_GL, &gl) ||
+      gl.version < NX_SHARED_GL_INTERFACE_VERSION || !gl.create)
+    return nullptr;
+  void* handle = gl.create();
+  if (!handle)
+    return nullptr;
+  return std::make_unique<GLContextLRShared>(gl, handle, m_opengl_mode);
+}
