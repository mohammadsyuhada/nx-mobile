 	// Required swapchain extension
 	tryAddDeviceExtension(vk::KHRSwapchainExtensionName);
 
+	// nx-mobile: also the frontend's required extensions (libretro_vulkan.h asks a core to enable them): its bridge imports
+	// each frame into an AHardwareBuffer, which needs VK_ANDROID_external_memory_android_hardware_buffer and its deps.
+	for (unsigned i = 0; i < num_required_device_extensions; i++)
+	{
+		const std::string_view name = required_device_extensions[i];
+		if (std::none_of(enabledExtensions.begin(), enabledExtensions.end(), [&](const char* e) { return name == e; }))
+			tryAddDeviceExtension(name);
+	}
+
 	// Enable VK_KHR_dedicated_allocation if available
 	if (physicalDeviceProperties.apiVersion >= VK_API_VERSION_1_1) {
 		// Core in Vulkan 1.1
diff --git a/shell/libretro/oslib.cpp b/shell/libretro/oslib.cpp
index a32d109..329f671 100644
--- a/shell/libretro/oslib.cpp
+++ b/shell/libretro/oslib.cpp
@@ -42,28 +42,25 @@ std::string getVmuPath(const std::string& port, bool save)
 	if ((per_content_vmus == 1 && port == "A1")
 			|| per_content_vmus == 2)
 	{
+		// nx-mobile: name per-game VMUs after the content file (not the disc's game ID) so the frontend's
+		// saves mirror can tie <content>.A1.bin to its game. A game-ID file from an earlier run is read once, then
+		// rewritten as <content>.A1.bin and deleted (maple_devs.cpp OnSetup: the save path differs from the read one).
 		std::string vmuDir = vmu_dir_no_slash + std::string(PATH_DEFAULT_SLASH());
-		if (settings.platform.isConsole() && !settings.content.gameId.empty())
-		{
-			constexpr std::string_view INVALID_CHARS { " /\\:*?|<>" };
-			std::string vmuName = settings.content.gameId;
-			for (char &c: vmuName)
-				if (INVALID_CHARS.find(c) != INVALID_CHARS.npos)
-					c = '_';
-			vmuName += "." + port + ".bin";
-			std::string wpath = vmuDir + vmuName;
-			if (save || file_exists(wpath.c_str()))
-				return wpath;
-			// Legacy path with rom name
-			std::string rpath = vmuDir + std::string(content_name) + "." + port + ".bin";
-			if (file_exists(rpath.c_str()))
-				return rpath;
-			else
-				return wpath;
-		}
-		return vmuDir + std::string(content_name) + "." + port + ".bin";
+		std::string byName = vmuDir + std::string(content_name) + "." + port + ".bin";
+		if (save || file_exists(byName.c_str()) || !settings.platform.isConsole() || settings.content.gameId.empty())
+			return byName;
+		constexpr std::string_view INVALID_CHARS { " /\\:*?|<>" };
+		std::string vmuName = settings.content.gameId;
+		for (char &c: vmuName)
+			if (INVALID_CHARS.find(c) != INVALID_CHARS.npos)
+				c = '_';
+		std::string byId = vmuDir + vmuName + "." + port + ".bin";
+		return file_exists(byId.c_str()) ? byId : byName;
 	}
 	else {
-		return std::string(game_dir_no_slash) + std::string(PATH_DEFAULT_SLASH()) + "vmu_save_" + port + ".bin";
+		// nx-mobile: shared VMUs (every port with per_content_vmus Disabled, the ports other than A1 with "VMU A1") live
+		// in the save directory like the per-game ones, so the frontend syncs them as saves; dc_nvmem/flash stay in the
+		// system folder. Loaded and saved there only: a card left in the system folder is not read (no migration).
+		return std::string(vmu_dir_no_slash) + std::string(PATH_DEFAULT_SLASH()) + "vmu_save_" + port + ".bin";
 	}
