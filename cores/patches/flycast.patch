diff --git a/core/hw/naomi/naomi_cart.cpp b/core/hw/naomi/naomi_cart.cpp
index 85fda83..e2f7f19 100644
--- a/core/hw/naomi/naomi_cart.cpp
+++ b/core/hw/naomi/naomi_cart.cpp
@@ -115,6 +115,12 @@ static bool loadBios(const char *biosName, Archive *child_archive, Archive *pare
 			{
 				verify(bios->blobs[romid].offset + bios->blobs[romid].length <= BIOS_SIZE);
 				u32 read = file->Read(biosData + bios->blobs[romid].offset, bios->blobs[romid].length);
+				// Atomiswave BIOS from the modern MAME set (bios.ic23_l) is a
+				// 64KB image in a 128KB window: mirror it the way the
+				// hardware's address decoding does.
+				if (!strcmp(bios->name, "awbios") && bios->blobs[romid].length == 0x10000
+						&& bios->blobs[romid].offset == 0)
+					memcpy(biosData + 0x10000, biosData, 0x10000);
 				if (config::GGPOEnable)
 					md5.add(biosData + bios->blobs[romid].offset, bios->blobs[romid].length);
 				DEBUG_LOG(NAOMI, "Mapped %s: %x bytes at %07x", bios->blobs[romid].filename, read, bios->blobs[romid].offset);
