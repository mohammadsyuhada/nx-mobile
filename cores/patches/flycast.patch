diff --git a/core/rend/gles/gles.h b/core/rend/gles/gles.h
index 9082a5d..bdab06a 100755
--- a/core/rend/gles/gles.h
+++ b/core/rend/gles/gles.h
@@ -365,7 +365,10 @@ inline void GlVertexArray::unbind()
 inline void GlVertexArray::term()
 {
 #ifndef GLES2
-	if (gl.gl_major >= 3)
+	// nx-mobile: never delete name 0 (a vertex array that was never bound, e.g. the post-processor's on the blit path).
+	// The spec ignores it, but the Android emulator's GLES stack drops the default vertex array's client state, and
+	// every later draw with client-side arrays (the frontend's presentation quad) draws nothing.
+	if (gl.gl_major >= 3 && vertexArray != 0)
 		glDeleteVertexArrays(1, &vertexArray);
 #endif
 	vertexArray = 0;
