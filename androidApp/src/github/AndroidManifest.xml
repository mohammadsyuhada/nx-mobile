<?xml version="1.0" encoding="utf-8"?>
<!-- The github flavor's in-app updater: it downloads the APK of the latest release and hands it to PackageInstaller. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- Keeps an update's download and its install wait alive off screen. -->
        <service
            android:name="com.nxredux.mobile.update.AppUpdateService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
        <!-- PackageInstaller's session status (an explicit PendingIntent): the confirm screen, a cancel or a failure. -->
        <receiver
            android:name="com.nxredux.mobile.update.UpdateInstallReceiver"
            android:exported="false" />
    </application>
</manifest>
