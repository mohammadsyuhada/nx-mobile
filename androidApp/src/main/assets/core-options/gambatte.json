    {
     "key": "gambatte_gb_colorization",
     "label": "GB Colorization",
     "labelCategorized": "",
     "info": "Enables colorization of Game Boy games. 'Auto' selects the 'best' (most colorful/appropriate) palette. 'GBC' selects game-specific Game Boy Color palette if defined, otherwise 'GBC - Dark Green'. 'SGB' selects game-specific Super Game Boy palette if defined, otherwise 'SGB - 1A'. 'Internal' uses 'Internal Palette' core option. 'Custom' loads user-created palette from system directory.",
     "values": [
      "disabled",
      "auto",
      "GBC",
      "SGB",
      "internal",
      "custom"
     ],
     "labels": [
      "",
