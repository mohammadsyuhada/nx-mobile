      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
     ],
     "default": "33"
    },
    {
     "key": "wswan_60hz_mode",
     "label": "60Hz Mode",
     "labelCategorized": "",
     "info": "Update the display at 60Hz instead of the native 75Hz WonderSwan refresh rate by dropping every fifth frame. Reduces video smoothness, but avoids screen tearing on displays that do not support native operation above 60Hz.",
     "values": [
      "disabled",
      "enabled"
     ],
     "labels": [
      "",
      ""
     ],
     "default": "enabled"
    },
    {
     "key": "wswan_sound_sample_rate",
     "label": "Sound Output Sample Rate",
     "labelCategorized": "",
     "info": "Higher values improve sound quality slightly at the expense of performance.",
