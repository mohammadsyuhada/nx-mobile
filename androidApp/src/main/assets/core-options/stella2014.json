    {
     "key": "stella2014_color_depth",
     "label": "Color Depth (Restart)",
     "labelCategorized": "",
     "info": "Specifies number of colors to display on-screen. 24-bit may increase performance overheads on some platforms.",
     "values": [
      "16bit",
      "24bit"
     ],
     "labels": [
      "Thousands (16-bit)",
      "Millions (24-bit)"
     ],
     "default": "16bit"
    },
    {
     "key": "stella2014_mix_frames",
     "label": "Interframe Blending",
     "labelCategorized": "",
     "info": "Simulates CRT phosphor ghosting effects. 'Simple' performs a 50:50 mix of the current and previous frames. 'Ghosting' accumulates pixels from multiple successive frames. May be used to alleviate screen flicker when games display large numbers of simultaneous objects by toggling sprites on alternate frames.",
     "values": [
      "disabled",
      "mix",
      "ghost_65",
      "ghost_75",
      "ghost_85",
      "ghost_95"
     ],
     "labels": [
      "",
      "Simple",
      "Ghosting (65%)",
      "Ghosting (75%)",
      "Ghosting (85%)",
      "Ghosting (95%)"
     ],
     "default": "disabled"
    },
    {
     "key": "stella2014_low_pass_filter",
     "label": "Audio Filter",
     "labelCategorized": "",
     "info": "Enables a low pass audio filter to soften the 'harsh' sound produced by the Atari 2600's TIA chip.",
