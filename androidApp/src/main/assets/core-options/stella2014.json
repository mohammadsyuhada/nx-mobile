    {
     "key": "stella2014_paddle_analog_response",
     "label": "Gamepad: Paddle Response (Analog)",
     "labelCategorized": "",
     "info": "Determines how the speed of the paddle varies when tilting the RetroPad analog stick. 'Linear': Speed is directly proportional to analog stick displacement. 'Quadratic': Speed increases quadratically with analog stick displacement; this allows for greater precision when making small movements without sacrificing maximum speed at full analog range. Applies when input device type is set to 'Gamepad'.",
     "values": [
      "linear",
      "quadratic"
     ],
     "labels": [
      "Linear",
      "Quadratic"
     ],
     "default": "linear"
    },
