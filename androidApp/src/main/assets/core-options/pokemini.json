    {
     "key": "pokemini_video_scale",
     "label": "Video Scale (Restart)",
     "labelCategorized": "",
     "info": "Set internal video scale factor. Increasing the scale factor improves the appearance of the internal 'Dot Matrix' LCD filter.",
     "values": [
      "1x",
      "2x",
      "3x",
      "4x",
      "5x",
      "6x",
      "7x"
     ],
     "labels": [
      "",
      "",
      "",
      "",
      "",
      "",
      ""
     ],
     "default": "4x"
    },
    {
     "key": "pokemini_60hz_mode",
     "label": "60Hz Mode",
     "labelCategorized": "",
     "info": "Update the display at 60Hz instead of the native 72Hz Pokemon Mini's refresh rate by dropping every sixth frame. Reduces video smoothness, but avoids screen tearing on displays that do not support native operation above 60Hz.",
     "values": [
      "disabled",
      "enabled"
     ],
     "labels": [
      "",
      ""
     ],
     "default": "enabled"
    },
    {
     "key": "pokemini_lcdfilter",
     "label": "LCD Filter",
     "labelCategorized": "",
     "info": "Select internal screen filter. 'Dot Matrix' produces an LCD effect that mimics real hardware. LCD filters are disabled when 'Video Scale' is set to '1x'.",
     "values": [
      "dotmatrix",
      "scanline",
      "none"
     ],
     "labels": [
      "Dot Matrix",
      "Scanlines",
      "None"
     ],
     "default": "dotmatrix"
    },
    {
     "key": "pokemini_lcdmode",
     "label": "LCD Mode",
     "labelCategorized": "",
     "info": "Specify the greyscale 'color' reproduction characteristics of the emulated liquid crystal display. 'Analog' mimics real hardware. '2 Shades' removes ghosting, but causes flickering in most games.",
