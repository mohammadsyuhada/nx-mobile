   "items": [
    {
     "key": "fceumm_sndrate_hint",
     "label": "Sound Samplerate (Hint)",
     "labelCategorized": "",
     "info": "The NES has no sample-based audio hardware; sound is synthesized in realtime, so there is no fixed output samplerate. Select the rate the core generates audio at. Higher rates lower latency and reduce aliasing and low-pass 'smearing' from frontend resampling, at a small performance cost. 'Auto' picks whichever supported rate is closest to the frontend's target output rate.",
     "values": [
      "Auto",
      "32KHz",
      "44KHz",
      "48KHz",
      "96KHz"
     ],
     "labels": [
      "",
      "",
      "",
      "",
      ""
     ],
     "default": "Auto"
    },
    {
     "key": "fceumm_sndquality",
     "label": "Sound Quality",
     "labelCategorized": "",
     "info": "Enable higher quality sound. Increases performance requirements.",
     "values": [
      "Low",
      "High",
      "Very High"
     ],
     "labels": [
      "",
      "",
      ""
     ],
     "default": "Low"
    },
    {
     "key": "fceumm_sndlowpass",
     "label": "Audio RF Filter",
     "labelCategorized": "",
     "info": "Apply a low pass audio filter to simulate the 'muted' sound of the NES when connected to a television via the RF modulator.",
     "values": [
      "disabled",
      "enabled"
     ],
     "labels": [
      "",
      ""
     ],
     "default": "disabled"
    },
    {
     "key": "fceumm_removetrianglenoise",
     "label": "Reduce Triangle Channel Popping",
     "labelCategorized": "",
     "info": "Mute the triangle channel when its period drops into the ultrasonic range (period <= 3, > ~12 kHz at NTSC).  Eliminates the audible popping some games (Castlevania II: Simon's Quest, Jackal, etc.) produce in High / Very High sound quality, where the DAC reconstruction filter would otherwise fold the ultrasonic content back into the audible range.  Low quality is unaffected (it already silences ultrasonic triangle output).",
     "values": [
      "disabled",
      "enabled"
     ],
     "labels": [
      "",
      ""
     ],
     "default": "disabled"
    },
    {
     "key": "fceumm_reducedmcpopping",
     "label": "Reduce DMC Channel Popping",
     "labelCategorized": "",
     "info": "Smooth direct writes to the DMC DAC register ($4011) by stepping the DAC only halfway toward each new value.  Reduces the audible click when games (Castlevania II: Simon's Quest, etc.) pulse the DAC for manual sample playback.  Normal DPCM bit-stream sample playback is unaffected.",
     "values": [
      "disabled",
      "enabled"
     ],
     "labels": [
      "",
      ""
     ],
     "default": "disabled"
    },
    {
     "key": "fceumm_sndstereodelay",
